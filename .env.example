NODE_ENV=development
DATABASE_URL=postgresql://rotavise:rotavise_local_only@127.0.0.1:54329/rotavise
API_HOST=127.0.0.1
API_PORT=3000
# Client addresses for quotas: false, 1–9 trusted proxy hops, or proxy IPs/CIDRs.
# Production must set it explicitly; never trust headers from an open network.
# TRUST_PROXY=false
WORKER_HOST=127.0.0.1
WORKER_PORT=3001
DEV_HARNESS_ENABLED=true
DEV_HARNESS_TOKEN=replace-with-local-random-token-at-least-32-characters
WEATHER_ENABLED=false
PLANS_ENABLED=false
PLANNING_ENABLED=false
AUTH_ENABLED=false
# accounts:setup adds a random AUTH_SECRET and enables local account/planning tests.
# AUTH_SECRET=<independent-random-secret-at-least-48-characters>
# AUTH_BASE_URL=http://127.0.0.1:5173
# AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173
# Optional Google OAuth web client; local callback is http://127.0.0.1:5173/api/auth/callback/google
# GOOGLE_CLIENT_ID=<client-id>
# GOOGLE_CLIENT_SECRET=<client-secret>
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_TLS=local
# MAIL_FROM=rotavise@example.invalid
# Production: HTTPS and SMTP_TLS=starttls/implicit; configure real credentials/domain.
PLAN_CATALOG_ID=rotavise-pilot
PLAN_CATALOG_VERSION=0.1.0
# Required when weather is enabled; keep it on the server, never in VITE_* variables.
# WEATHER_INTERNAL_TOKEN=<independent-random-secret-at-least-32-characters>
# Future climate (NEX-GDDP-CMIP6 via NCCS THREDDS; no account). Needs planning.
# CLIMATE_SCENARIOS_ENABLED=false
# SCENARIO_FETCH_CONCURRENCY=2
# SCENARIO_TILES_PER_DAY=4
# NASA Earthdata Login for AppEEARS (HLS, SMAP) and GES DISC (GPM IMERG).
# Use a dedicated account for Rotavise; server-only, never in VITE_* variables.
# EARTHDATA_USERNAME=<earthdata-username>
# EARTHDATA_PASSWORD=<earthdata-password>
# OBSERVATIONS_ENABLED=false
# Science service for yields and soil carbon (infra/science/compose.yaml).
# SCIENCE_URL=http://127.0.0.1:8090
# Claude for crop photo checks and plan explanations (console.anthropic.com).
# Server-only, never in VITE_* variables. Without it those routes answer
# AI_NOT_CONFIGURED. AI_DAILY_REQUEST_LIMIT caps calls per day for all users.
# ANTHROPIC_API_KEY=<anthropic-api-key>
# Optional; the default is claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_DAILY_REQUEST_LIMIT=300
