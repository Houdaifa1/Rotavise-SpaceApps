# Rotavise production settings. `pnpm ops:init` copies this file to
# .env.production with fresh random secrets and mode 600. Never commit the
# result and never paste its contents into a chat.
NODE_ENV=production
# The proxy container is the only hop in front of the API.
TRUST_PROXY=1
# Local address the proxy listens on (127.0.0.1 only).
PROXY_PORT=8088

POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
DATABASE_URL=postgresql://rotavise:{{POSTGRES_PASSWORD}}@postgres:5432/rotavise
# Existing local PostgreSQL: preserve your password and change only the final
# database name to /rotavise. Example local-only credentials (not production):
# DATABASE_URL=postgresql://rotavise:rotavise_local_only@127.0.0.1:54329/rotavise

PLANS_ENABLED=true
# Optional precomputed FTW suggestions. Import reviewed data before enabling.
FIELD_BOUNDARIES_ENABLED=false
PLANNING_ENABLED=true
PLAN_CATALOG_ID=rotavise-pilot
ROTATION_CATALOG_VERSION=0.15.0
WEATHER_ENABLED=true
WEATHER_INTERNAL_TOKEN={{WEATHER_INTERNAL_TOKEN}}
CLIMATE_SCENARIOS_ENABLED=true
SCIENCE_URL=http://science:8090
AI_DAILY_REQUEST_LIMIT=300

# ---- The owner fills in the lines below later; each is off until then. ----
# Claude photo check and explanations: paste the key here, then run
# `pnpm ops:upgrade`. Leave the line commented out until you have a key.
# ANTHROPIC_API_KEY=

# NASA Earthdata (field satellite history, soil moisture, rain). Needs
# OBSERVATIONS_ENABLED=true and an account system (AUTH_ENABLED=true).
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# OBSERVATIONS_ENABLED=false

# Accounts, Google sign-in and email. Turn on only when the public address,
# Resend (SMTP) and the Google OAuth client exist; AUTH_BASE_URL must be https.
# AUTH_ENABLED=true
# AUTH_SECRET={{AUTH_SECRET}}
# AUTH_BASE_URL=https://app.example.com
# AUTH_TRUSTED_ORIGINS=https://app.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_TLS=implicit
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# Optional operations mail alerts: set a recipient only after SMTP_* and
# MAIL_FROM above are configured. No messages are sent with this unset.
# OPS_ALERT_TO=
# Optional alert policies (owner choices, no provider SLA assumed).
# JSON must be unquoted, for example a map of provider IDs to maximum age hours.
# OPS_INGEST_MAX_AGE_HOURS={}
# OPS_QUEUE_DEPTH_LIMIT=
# OPS_TILE_MAX_IDLE_MINUTES=

# Readiness fails while the database is incomplete (this is the default in production).
DATA_COMPLETENESS_REQUIRED=true
