<script src="/scripts/js/moment-with-locales.min.js"></script>
<style>

    .new-tag {
        position: absolute;
        top: 8px;
        right: 81%;
        color: white;
        font-size: 9px;
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 4px;
        font-family: 'Arial Black', sans-serif;
        text-transform: uppercase;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        transform: rotate(0deg) !important;
        z-index: 10;
        animation: pulse 2s infinite linear;
        background: linear-gradient(135deg, #d50000, #ff1744);
    }

    /* Animation pulsante */
    @keyframes pulse {
        0%, 100% {
            transform: rotate(-5deg) scale(1);
            background: linear-gradient(135deg, #d50000, #ff1744);
        }

        50% {
            transform: rotate(-5deg) scale(1.1);
            background: linear-gradient(135deg, #ff5252, #ff1744);
        }
    }


    /* header {
        padding: 10px 0;
        background: rgb(9 45 97 / 45%) !important;
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 100;
        height: 514px !important;
    }*/
    .Spinner {
        position: fixed;
        z-index: 1000;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        background: rgba( 255, 255, 255, .8 ) url('/media/1231/throbber_12.gif') 50% 50% no-repeat;
    }

    body.loading .Spinner {
        display: block;
    }

    #Cartoches1 .pic img {
        /*border: 3px double #ddd;*/
        border-radius: 30%;
        box-shadow: 0 3px 6px 1px #c5c5c5;
    }

    #Cartoches1 .txt a {
        margin-top: 4px;
        display: block;
    }
</style>

