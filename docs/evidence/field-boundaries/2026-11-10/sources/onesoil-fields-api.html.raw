<a id="__codelineno-2-7" name="__codelineno-2-7" href="#__codelineno-2-7"></a><span class="w">  </span><span class="nx">geometry_wkt</span><span class="o">:</span><span class="w"> </span><span class="nx">wellknown</span><span class="p">.</span><span class="nx">stringify</span><span class="p">({</span>
