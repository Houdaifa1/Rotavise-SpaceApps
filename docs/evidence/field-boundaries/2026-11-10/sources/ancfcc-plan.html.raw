            $("#idfiscalarea").hide();
            $("#certificatForm").css("height", "auto"); 
        }

        //$("#DivFirstPage").hide();
       // $("#DivNext").show();


    });



    $('#DivNombreCopies').hide();
    function DLLFormatChangefunc(id) {
        if (id == "2") $('#DivNombreCopies').show();
        else {
            $('#DivNombreCopies').hide();
            $('#TextBoxNombre').val('1');

        }

    }

    function HideEditButton() {

        if ($("#DivFirstPage").is(":visible")) {

            $("#BtnGeneratePDF").show();
            $("#DivPaiement").show();
        }
        else {
            $('#SpinnerLoading').show(0).delay(8000).hide(0);
            $("#BtnGeneratePDF").hide();
            $("#DivPaiement").show();
        }
    }

    //new m.b
    $('#TextBoxAdresse').keyup(function () {
        $(this).val($(this).val().toUpperCase());
    }); 


    $('#FormSuiviTitres').on('keyup keypress', function (e) {
        var keyCode = e.keyCode || e.which;
        if (keyCode === 13) {
            e.preventDefault();
            return false;
        }
    });

    $('#TermesAndConditions').click(function () {
        console.log("termes");
        var redirectWindow = window.open('../Conditions/conditions-generales-utilisation-Fr.html', '_blank');
        redirectWindow.location;
    });
    $('#MentionsLegales').click(function () {
        console.log("termes");
        var redirectWindow = window.open('https://www.ancfcc.gov.ma/MentionsLegales/', '_blank');
        redirectWindow.location;
    });
    $("#SpinnerLoading").hide();

    $(document)
        .ajaxStart(function () {
            $("#SpinnerLoading").show();
        })
        .ajaxStop(function () {
            $("#SpinnerLoading").hide();
        });
    var NotifToaster = {
        SucessType: "success",
        InfoType: "info",
        WarningType: "warning",
        ErrorType: "error",
        Bottom_Right: "toast-bottom-right",
        Top_Full_Width: "toast-top-full-width",

        CodeSMSFalse: "Le code SMS saisi est invalide !",
        CodeCaptchaFalse: "Le code de confirmation saisi est invalide !",
        ErreurWebServices: "Erreur au niveau de vérification des titres fonciers !",
        ErreurCheckConnectivity: "Erreur au niveau de vérification des titres fonciers ,Merci de réessayer plus tard",
        NumTelephoneInvalide: "Le numéro de téléphone saisi est invalide !",
        CodeTelephoneNotValidated: "Merci de valider le code de vérification reçu par téléphone !",
        CodeEmailNotValidated: "Merci de valider le code de vérification reçu par email !",
        CheckCondition: "Veuillez lire et accepter et les mentions légales et les conditions générales d&rsquo;utilisation",
        EmailInvalide: "l&rsquo;adresse mail saisie est invalide !",
        NumTelephonevalide: "Numéro téléphone valide",
        SMSEnoyer: "Le code de validation a été envoyé à votre téléphone",
        EmailEnoyer: "Le code de validation a été envoyé à votre boite mail",
        SendSMSService: "Une erreur s&rsquo;est produite lors de l&rsquo;envoie du SMS,merci de réessayer plus tard",
        SendEmailService: "Une erreur s&rsquo;est produite lors de l&rsquo;envoie du mail,merci de réessayer plus tard",
        ICE: "Merci de renseigner ICE",
        TitreFoncierInfo: "Merci de saisir les informations de votre titre foncier",
        TitreFoncierMissing: "Merci de saisir au moins un titre foncier",
        TitreFoncierExisteDeja: "Ce titre foncier existe dèjà dans la liste",

    }

    function ReloadCapchaSMS() {
        $("#CapchaImgSMS").removeAttr("src").attr("src", "/AdminLogin/Surface/CalculeAndMapSurface/DisplaySMS/?d=" + new Date().getTime());
    }

    function ReloadCapcha() {
        $("#CapchaImg").removeAttr("src").attr("src", "/AdminLogin/Surface/CalculeAndMapSurface/Display/?d=" + new Date().getTime());
    }

    $.validator.addMethod("CINValidation", function (value, element) {
        return this.optional(element) || /^[a-zA-Z]{1,2}[0-9]{1,8}[A-Za-z0-9]{0,3}[A-Za-z0-9]{0,3}$/.test(value);
    }, "رقم بطاقة الهوية غير صحيح");

    $.validator.addMethod("Alpha", function (value, element) {
        return this.optional(element) || /^[\s]|[a-zA-Z]+/.test(value);
    }, "Only Alpha");

    $.validator.addMethod("AlphaNumbers", function (value, element) {
        return this.optional(element) || /^([\s]|[\sa-zA-Z0-9]|[,.°/_-])*$/.test(value);
    }, "Alpha Numbers");

    $.validator.addMethod("Arabic", function (value, element) {
        return this.optional(element) || /^([\s]|[\u0600-\u06ff]|[\u0750-\u077f]|[\ufb50-\ufbc1]|[\ufbd3-\ufd3f]|[\ufd50-\ufd8f]|[\ufd92-\ufdc7]|[\ufe70-\ufefc]|[\ufdf0-\ufdfd])*$/g.test(value);
    }, "Only Arabic");

    $.validator.addMethod("ArabicNumbers", function (value, element) {
        return this.optional(element) || /^([\s]|[0-9]|[,.°/_-]|[\u0600-\u06ff]|[\u0750-\u077f]|[\ufb50-\ufbc1]|[\ufbd3-\ufd3f]|[\ufd50-\ufd8f]|[\ufd92-\ufdc7]|[\ufe70-\ufefc]|[\ufdf0-\ufdfd])*$/g.test(value);
    }, "Only Arabic Num");
    $.validator.addMethod("French", function (value, element) {
        return this.optional(element) || /^([\s]|[a-zA-Z]|[àâçéèêëîïôûùüÿñ])+$/.test(value);
    }, "Only Latin Num");

    $.validator.addMethod("FrenchNumbers", function (value, element) {
        return this.optional(element) || /^([\s]|[\sa-zA-Z0-9]|[àâçéèêëîïôûùüÿñ]|[:,.°/_-]|[;/])*$/.test(value);
    }, "Only Latin Num");

    $.validator.addMethod("TelephoneValidation", function (value, element) {
        return value.match(/^\+(?:[0-9] ?){6,14}[0-9]$/);
    }, 'Enter Valid  phone number');

    $("#FormCertificats").validate({
        rules: {
            "Nom": {
                required: true,
                French: true,
            },
            "NomAr": {
                required: true,
                Arabic: true
            },
            "Prenom": {
                required: true,
                French: true
            },
            "PrenomAr": {
                required: true,
                Arabic: true
            },
            "Surnom": {
                required: false,
                Arabic: true
            },
            "Adresse": {
                required: true,
                FrenchNumbers: true
            },
            "Identifiant": {
                required: true,
                CINValidation: true
            },
            "Telephone": {
                required: true,
                TelephoneValidation: true
            }
        },
        errorPlacement: function () { },
        errorClass: "errorTestClass",

    });


    function CheckSMSValide() {
        var CodeSMS = $("#TextBoxCodeVertification").val();
        var lResult = {};
        $.ajax({
            url: '/AdminLogin/surface/CalculeAndMapSurface/ValidateCodeSMS/',
            type: 'POST',
            dataType: 'json',
            async: true,
            data: '{ "CodeSMS": ' + CodeSMS + ' }',
            contentType: 'application/json; charset=utf-8',
            success: function (Result) {
                lResult = Result;
                console.log(lResult);
                if (lResult == false)
                    ShowNotification(NotifToaster.CodeCaptchaFalse, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
                else {
                    $("#TextBoxCodeVertification").prop("disabled", true);
                    $("#TextBoxCodeVertification").addClass('SuccessClassTel');
                    $("#phone").val($("#PhoneValid").val());
                    $("#phone").prop("disabled", true);
                    $("#phone").addClass('SuccessClassTel');
                    $("#SendVerification").hide();
                    $("#ValidateCodeSMS").hide();

                    $("#codeCaptchaSMS").hide();
                    $("#DivCapchaImgSMS").hide();

                    $('#BtnGeneratePDF').prop('disabled', false);
                    $("#HiddenPhoneChecked").val('1');

                    $("#HiddenPhoneValid").val(CodeSMS);


                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.status);
                alert(thrownError);
            }

        });


    }

    function ReturnToFirstPage() {
        $("#DivNext").hide();
        $("#DivNextRegularise").hide();
        $("#DivFirstPage").show();
    }
    $("#SWitchToNext").prop("disabled", false);
    var countDocument = 0;
    if ($('#pTitreFoncierModal[0].Reference').val() != "")
        $("#documentTable").hide();
    else $("#documentTable").show();
     



    function SendValidation() {

        //codeCaptchaSMS
        $("#erreurCodeSMS").html("");
        $("#erreurCodeSMS").hide();

        if ($("#codeCaptchaSMS").val().trim() == "") {

            $("#erreurCodeSMS").html("Veuillez saisir le code captcha !");
            $("#erreurCodeSMS").show();
            return;
        }
        if ($("#phone").valid() == false) {
            $("#erreurCodeSMS").html(NotifToaster.NumTelephoneInvalide);
            $("#erreurCodeSMS").show();
            return;
        }

        ValidateSms($("#phone").val(), $("#codeCaptchaSMS").val());

    }



    function CheckTitresFonciers() {

        $('#dvTerms').html('');
        $('#dvTerms').hide();

        var typeDem = $('input[name=typeDemandeur]:checked').val();


        var iceValid = true;

        if (typeDem && typeDem == "persMorale") {
            var lICE = $("#TextBoxICE").val();

            if (!lICE) {
                iceValid = false;
                ShowNotification(NotifToaster.ICE, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
            }

            var IdentifiantFiscal = $("#IdentifiantFiscal").val();
            if (!IdentifiantFiscal) {
                iceValid = false;
                ShowNotification(NotifToaster.IDFiscal, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
            }

            if (lICE && IdentifiantFiscal) { iceValid = true; }
        }

        if (iceValid) {
       
            if (!$("#FormCertificats").valid()) {
                $('form').find('input[type="submit"]').click();
                return false;
            }

            var lEmail = "";
            if ($("#TextBoxEmail").val()) {
                lEmail = $("#TextBoxEmail").val();
            }


            var TermsChecked = $('#chkTerms').is(":checked");
            if (TermsChecked != true) {
                var lib = "Veuillez accepter les mentions légales et les conditions générales d’utilisation";
                lib += "<br/>";
                lib += "المرجو قبول الشروط العامة للاستخدام";
                $('#dvTerms').html(lib);
                $('#dvTerms').show();
                return;
            }



            if (arrayTitreFoncier.length > 0) {
                var hdnVal = $("#TypeDemande").val();
                var Type;
                console.log(hdnVal);
                if (hdnVal == "DemandeCalculeContenance")
                    Type = 12;
                else Type = 13;
                var ListeTitresValidated = new Array();
                var DemandeSuiviTitre = {
                    Nom: $("#TextBoxNom").val(),
                    NomAr: $("#TextBoxNomAr").val(),
                    Prenom: $("#TextBoxPrenom").val(),
                    PrenomAr: $("#TextBoxPrenomAr").val(),
                    Surnom: $("#TextBoxSurnom").val(),
                    Identifiant: $("#TextBoxIdentifiant").val(),
                    JourNaissance: $("#JourNaissance").val(),
                    MoisNaissance: $("#MoisNaissance").val(),
                    AnneeNaissance: $("#TextBoxAnneeNaissance").val(),
                    CodeVertification: $("#TextBoxCodeVertification").val(),
                    CodeVertificationEmail: $("#TextBoxCodeVertificationEmail").val(),
                    CodeVertificationHidden: $("#HiddenPhoneValid").val(),
                    CapchaCode: $("#TextBoxCapchaCode").val(),
                    Email: lEmail,
                    TypeDemande: Type,
                }

                console.log(DemandeSuiviTitre);
                var lResult = {};
                $.ajax({
                    url: '/AdminLogin/surface/CalculeAndMapSurface/CheckFormulaire',
                    type: 'POST',
                    dataType: 'json',
                    async: true,
                    data: JSON.stringify({ 'arrayTitreFoncier': arrayTitreFoncier, 'DemandeSuiviTitre': DemandeSuiviTitre }),
                    contentType: 'application/json; charset=utf-8',
                    success: function (Result) {
                        lResult = Result;
                        console.log(lResult);
                        if (lResult.Statut > 0) {

                            console.log(lResult.Value);
                            var string = "";
                            var Somme = 0;
                            var StatutTrue = false;
                            for (var i = 0; i < lResult.Value.length; i++) {
                                var LibelleSpecial = "";
                                var Categorie = "";
                                if (lResult.Value[i].CatgorieTitre == '2')
                                    Categorie = "R";
                                else Categorie = "T";
                                if (lResult.Value[i].SelectedIndiceSpecialLibelle != null)
                                    LibelleSpecial = lResult.Value[i].SelectedIndiceSpecialLibelle;
                                string += '<tr>';
                                string += '<td class="text-center">' + lResult.Value[i].SelectedConservationFonciereLibelle + '</td>';
                                string += '<td class="text-center">' + Categorie + lResult.Value[i].Reference + '/' + lResult.Value[i].SelectedIndiceLibelle + '/' + LibelleSpecial + '</td>';

                                string += '<td class="text-center">';
                                if (lResult.Value[i].Statut == '1') {
                                    StatutTrue = true,
                                        string += '<span class="label label-success">' + lResult.Value[i].Message + '</span>';
                                }
                                else if (lResult.Value[i].Statut == '0')
                                    string += '<span class="label label-danger">' + lResult.Value[i].Message + '</span>';
                                else string += '<span class="label label-warning">' + lResult.Value[i].Message + '</span>';
                                string += '</td>';
                                string += '<td class="text-center">' + lResult.Value[i].Montant + ' DH</td>';
                                Somme += lResult.Value[i].Montant;
                                string += '</tr>';

                            }
                            string += '<tr>';
                            string += '<td></td><td></td><td class="text-center" style="font-weight : bold">Montant Total :</td><td class="text-center" style="font-weight : bold">' + Somme + ' DH</td>';
                            string += '</tr>';
                            $("#tbodyTitreFoncierInfo").empty();
                            $("#tbodyTitreFoncierInfo").append(string);
                            $("#DivNext").show();
                            $("#DivNextRegularise").hide();
                            $("#DivFirstPage").hide();
                            if (StatutTrue) {
                                $("#BtnGeneratePDF").show();
                                $("#DivPaiement").show();
                            }
                            else {
                                $("#BtnGeneratePDF").hide();
                                $("#DivPaiement").hide();
                            }

                        } else if (lResult.Statut == '-1') ShowNotification(NotifToaster.CodeCaptchaFalse, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
                        else if (lResult.Statut == '-2') ShowNotification(NotifToaster.ErreurWebServices, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
                        else if (lResult.Statut == '-3') window.location.reload();
                        else if (lResult.Statut == '-4') ShowNotification(NotifToaster.ErreurCheckConnectivity, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
                        else if (lResult.Statut == '-5') ShowNotification('Pour votre commande, veuillez choisir la même Conservation Foncière.', NotifToaster.ErrorType, NotifToaster.Top_Full_Width);

                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        alert(xhr.status);
                        alert(thrownError);
                    }

                });


            } else ShowNotification(NotifToaster.TitreFoncierMissing, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);


        }
    }



    function DeleteTitre(idValue) {
        for (var i = 0; i < arrayTitreFoncier.length; i++)
            if (arrayTitreFoncier[i].id == idValue) {
                arrayTitreFoncier.splice(i, 1);
                break;
            }
        $("#TROW" + idValue).remove();
        if (arrayTitreFoncier.length == 0)
            $('#DropDownConservation').prop('disabled', false);
        console.log(arrayTitreFoncier);

    }


    //M.B
    $("#TextBoxIdentifiant").blur(function () {
        $("#TextBoxIdentifiant").val($("#TextBoxIdentifiant").val().replace(/\s/g, ''));
      //  document.getElementById("TextBoxIdentifiant").focus();
      //  $('#TextBoxIdentifiant').blur();

    });

  
    //M.B
    $("#TextBoxReference").blur(function () {
        $("#TextBoxReference").val($("#TextBoxReference").val().replace(/\./g, ''));
    });



    function ValidateSms(NumTelephone, CodeCaptcha) {
        var lResult = {};
        $.ajax({
            url: '/AdminLogin/surface/CalculeAndMapSurface/SendSMSValidation/',
            type: 'POST',
            dataType: 'json',
            traditional: true,
            data: { "NumeroTelephone": NumTelephone, "CodeCaptcha": CodeCaptcha },
            success: function (Result) {
                lResult = Result;

                if (lResult.Statut == "1") {

                    $("#HiddenPhoneValid").val(lResult.Code);
                    $("#PhoneValid").val(NumTelephone);
                    $("#DivValidationSMS").show();
                    $("#SendVerification").prop('value', 'Réenvoyer le Code SMS');
                    ShowNotification(NotifToaster.SMSEnoyer, NotifToaster.SucessType, NotifToaster.Top_Full_Width);
                } else {

                    $("#HiddenPhoneValid").val('');
                    $("#erreurCodeSMS").html(lResult.Message);
                    $("#erreurCodeSMS").show();
                    ReloadCapchaSMS();
                    ShowNotification(lResult.Message, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
                }

            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("#HiddenPhoneValid").val('');
                $("#erreurCodeSMS").html(NotifToaster.SendSMSService);
                $("#erreurCodeSMS").show();
                ReloadCapchaSMS();
                ShowNotification(NotifToaster.SendSMSService, NotifToaster.ErrorType, NotifToaster.Top_Full_Width);
            }

        });
    }




    function DropListChangeTypeIdentite(choixID) {
        if (choixID == 2) {
            console.log("")
            $("#TextBoxIdentifiant").rules("remove", "CINValidation");
        } else $("#TextBoxIdentifiant").rules("add", "CINValidation");
    }


    function DropListConservationChangefunc(choixID, isCAD = false) {
        if (Math.floor(choixID) == choixID && $.isNumeric(choixID)) {
            var lResult = {};
            $.ajax({
                url: '/AdminLogin/surface/DemandeCertificatsSurface/ListIndices/',
                type: 'POST',
                dataType: 'json',
                async: true,
                data: '{ "ConservationId": ' + choixID + ' }',
                contentType: 'application/json; charset=utf-8',
                success: function (Result) {
                    lResult = Result;
                    for (var i = 0; i < lResult.ListIndices.length; i++) {

                        $("#DLLIndice").append("<option value='" + lResult.ListIndices[i].Id + "' >" + lResult.ListIndices[i].Libelle + "</option>");
                    }

                    for (var i = 0; i < lResult.ListIndicesSpecial.length; i++) {

                        $("#DLLIndiceSpecial").append("<option value='" + lResult.ListIndicesSpecial[i].Id + "' >" + lResult.ListIndicesSpecial[i].Libelle + "</option>");
                    }
                    if (isCAD) {
                        fetch('/AdminLogin/surface/DemandeCertificatsSurface/GetIndiceFusionCAD/', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ choixID: choixID })
                        }).then(response => response.json())
                            .then(data => {
                                for (var i = 0; i < data.lListIndice.length; i++) {
                                    if (!Array.from(document.getElementById("DLLIndice").options).some(option => option.text === data.lListIndice[i].Libelle)) {
                                        $("#DLLIndice").append("<option value='" + data.lListIndice[i].Id + "' >" + data.lListIndice[i].Libelle + "</option>");
                                    }
                                }
                                for (var i = 0; i < data.lListIndiceSpecial.length; i++) {
                                    if (!Array.from(document.getElementById("DLLIndiceSpecial").options).some(option => option.text === data.lListIndiceSpecial[i].Libelle)) {
                                        $("#DLLIndiceSpecial").append("<option value='" + data.lListIndiceSpecial[i].Id + "' >" + data.lListIndiceSpecial[i].Libelle + "</option>");
                                    }
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error); // Handle any errors
                            });
                    }


                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.status);
                    alert(thrownError);
                }

            });

            $("#DLLIndice").empty();
            $("#DLLIndice").append("<option value='' >----</option>");

            $("#DLLIndiceSpecial").empty();
            $("#DLLIndiceSpecial").append("<option value='' >----</option>");


        }
    }


    var CountTitres = 0;
    var arrayTitreFoncier = new Array();

    function sanitize(input) {
        return $('<div/>').text(input).html(); // escapes HTML characters
    }

    function addDocument() {
        var TitreFoncierDemandeSuiviModal = {
            id: 0,
            SelectedConservationFonciereLibelle: "",
            SelectedConservationFonciereId: 0,
            SelectedIndiceId: 0,
            SelectedIndiceLibelle: "",
            SelectedIndiceSpecialLibelle: "",
            SelectedIndiceSpecialId: 0,
            Reference: "",
            Nombre: 1,
            FormatId: 0,
            FormatLibelle: "",
            CatgorieTitre: 1
        }
        console.log("Enter Function");
        var DropDownConservationValue = sanitize($("#DropDownConservation option:selected").text());
        var DropDownConservation = $("#DropDownConservation").val();

        var DropDownFormatValue = sanitize($("#DLLFormat option:selected").text());
        var DropDownFormat = $("#DLLFormat").val();


        var DLLIndiceValue = sanitize($("#DLLIndice option:selected").text().trim());
        var DLLIndice = $("#DLLIndice").val();

        var DLLCategoie = $("#DropDownCategorie").val();

        var DLLIndiceSpecialValue = ($("#DLLIndiceSpecial").val() !== "") ?
            sanitize($("#DLLIndiceSpecial option:selected").text().trim()) : "";

        var DLLIndiceSpecial = $("#DLLIndiceSpecial").val();

        var TextBoxReference = $("#TextBoxReference").val();
        var TextBoxNombreCopies = $("#TextBoxNombre").val();

        CountTitres++;
        var Existe = false;
        for (var i = 0; i < arrayTitreFoncier.length; i++)
            if (arrayTitreFoncier[i].SelectedConservationFonciereId == DropDownConservation &&
                arrayTitreFoncier[i].SelectedIndiceId == DLLIndice &&
                arrayTitreFoncier[i].Reference == TextBoxReference &&
                arrayTitreFoncier[i].CatgorieTitre == DLLCategoie) {
                Existe = true;
                break;
            }
        if (DropDownConservation && DLLIndice && TextBoxReference) {
            if (Existe == false) {
                $("#documentTable").show();
                $("#certificatForm").css("height", "auto"); 
                $("#bodyDocumentTable").append("<tr  id='TROW" + CountTitres + "'>\
                                                <td>" + ((DLLCategoie == "2") ? "R" : "T") + TextBoxReference + "/" + DLLIndiceValue + " " + DLLIndiceSpecialValue + "</td>\
                                                <td>" + DropDownConservationValue + "</td>\
           <td><a onclick='DeleteTitre(" + CountTitres + ")' style='cursor: pointer;color:red'><i class='fa fa-2x fa-times'></i></a></tr>");
                TitreFoncierDemandeSuiviModal.id = CountTitres;
                TitreFoncierDemandeSuiviModal.SelectedConservationFonciereLibelle = DropDownConservationValue;
                TitreFoncierDemandeSuiviModal.SelectedConservationFonciereId = DropDownConservation;
                TitreFoncierDemandeSuiviModal.SelectedIndiceId = DLLIndice;
                TitreFoncierDemandeSuiviModal.SelectedIndiceLibelle = DLLIndiceValue;
                TitreFoncierDemandeSuiviModal.SelectedIndiceSpecialLibelle = DLLIndiceSpecialValue;
                TitreFoncierDemandeSuiviModal.SelectedIndiceSpecialId = DLLIndiceSpecial;
                TitreFoncierDemandeSuiviModal.Reference = TextBoxReference;
                TitreFoncierDemandeSuiviModal.Nombre = TextBoxNombreCopies;
                TitreFoncierDemandeSuiviModal.FormatId = DropDownFormat;
                TitreFoncierDemandeSuiviModal.FormatLibelle = DropDownFormatValue;
                TitreFoncierDemandeSuiviModal.CatgorieTitre = DLLCategoie;
                console.log(TitreFoncierDemandeSuiviModal);
                arrayTitreFoncier.push(TitreFoncierDemandeSuiviModal);
                console.log(arrayTitreFoncier);

                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].SelectedConservationFonciereLibelle'>")
                $("[name='pTitreFoncierModal[" + countDocument + "].SelectedConservationFonciereLibelle']").val(DropDownConservationValue);
                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].SelectedConservationFonciereId' value=" + DropDownConservation + ">")
                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].SelectedIndiceId' value=" + DLLIndice + ">")
                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].SelectedIndiceLibelle' value=" + DLLIndiceValue + ">")
                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].SelectedIndiceSpecialLibelle' value=" + DLLIndiceSpecialValue + ">")
                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].SelectedIndiceSpecialId' value=" + DLLIndiceSpecial + ">")
                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].Reference' value=" + TextBoxReference + ">")
                $("#hiddenInputs").append("<input type='hidden' name='pTitreFoncierModal[" + countDocument + "].CatgorieTitre' value=" + DLLCategoie + ">")
                countDocument++;
                $('#DropDownConservation').prop('disabled', true);
            } else ShowNotification(NotifToaster.TitreFoncierExisteDeja, NotifToaster.WarningType, NotifToaster.Top_Full_Width);

        } else ShowNotification(NotifToaster.TitreFoncierInfo, NotifToaster.WarningType, NotifToaster.Top_Full_Width);
    }

    $(".phone").intlTelInput({
        nationalMode: false,
        excludeCountries: ['eh', 'il', 'tw'],
        preferredCountries: ['ma'],
        customPlaceholder: function (selectedCountryPlaceholder, selectedCountryData) {
            if (selectedCountryData.dialCode == "212")
                selectedCountryPlaceholder = "650123456";

            return selectedCountryPlaceholder;

        },
        utilsScript: "/Scripts/js/utils.js"
    });

    // on blur: validate
    $("#phone").blur(function () {

        if ($("#phone").val().substring(0, 2) == '00')
            $("#phone").val('+' + $("#phone").val().substring(2, $("#phone").val().length))

    });


</script>


    </div>
</div>


