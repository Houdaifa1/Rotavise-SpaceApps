dren\":\"\\\\\"}]\n3c:[\"$\",\"$L28\",null,{\"href\":\"/en/resources/category/company-news\",\"className\":\"shrink-0 hover:text-foreground-primary/60\",\"children\":\"Company news\"}]\n3d:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"shrink-0\",\"children\":\"\\\\\"}]\n3e:[\"$\",\"span\",null,{\"className\":\"truncate text-foreground-primary/60\",\"aria-current\":\"page\",\"title\":\"OneSoil Mobile Is Moving to Freemium\",\"children\":\"OneSoil Mobile Is Moving to Freemium\"}]\n3f:[\"$\",\"div\",null,{\"className\":\"relative aspect-square w-full max-w-[280px] shrink-0 overflow-hidden rounded-[1.5rem] sm:size-[320px] sm:max-w-none lg:size-[420px] lg:rounded-[2.5rem]\",\"children\":[\"$\",\"$L34\",null,{\"src\":\"/api/media/file/OneSoil%20Mob%20Application.png\",\"alt\":\"A-phone-with-OneSoil-mob-application-interface\",\"fill\":true,\"sizes\":\"(max-width: 640px) 100vw, (max-width: 1024px) 320px, 420px\",\"loading\":\"eager\",\"fetchPriority\":\"high\",\"className\":\"object-cover\"}]}]\n40:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"pt-8\",\"children\":[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-[1024px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"[\u0026_a]:text-accent-success [\u0026_a]:underline [\u0026_a]:transition-colors [\u0026_a]:hover:text-foreground-primary [\u0026_strong]:font-semibold [\u0026_strong]:text-accent-success\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"We started OneSoil with one idea: precision agriculture should belong to every farmer, not just to those who can afford expensive software. That idea hasn’t changed. But the way we run monitoring in the mobile app has to.\"]}],[\"$\",\"p\",\"1\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"As our community grows, so does the cost of running the app: satellite data, infrastructure and continuous development. A free-only model can no longer support that. Moving to freemium lets us keep OneSoil reliable and keep building new features for you.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"From 5 May, OneSoil mobile moved to a freemium model. The update rolled out gradually, so you may have seen the change a little later than the announcement.\"]}],[\"$\",\"h2\",\"3\",{\"id\":\"what-stays-free-for-every-farmer\",\"className\":\"mx-auto max-w-[864px] mb-4 text-[2.25rem] font-normal tracking-[-0.09rem] text-foreground-primary scroll-mt-24\",\"children\":[\"What stays free for every farmer\"]}],[\"$\",\"p\",\"4\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"If you use the OneSoil app casually, to check on your fields once in a while, take notes during scouting or look at the weather before a workday, the free version will continue to do everything you need.\"]}],[\"$\",\"p\",\"5\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"Free for everyone, with no limit on the number of fields:\"]}],[\"$\",\"ul\",\"6\",{\"className\":\"mx-auto max-w-[864px] mb-4 list-disc\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"The last cloud-free image per field: NDVI, moisture and satellite imagery\"]}],[\"$\",\"li\",\"1\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Virtual weather stations\"]}],[\"$\",\"li\",\"2\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Hyperlocal precipitation map for the next hour\"]}],[\"$\",\"li\",\"3\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Field notes with photos and geolocation\"]}],[\"$\",\"li\",\"4\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Access to all your fields and seasons\"]}]]}],[\"$\",\"h2\",\"7\",{\"id\":\"what-a-subscription-adds\",\"className\":\"mx-auto max-w-[864px] mb-4 text-[2.25rem] font-normal tracking-[-0.09rem] text-foreground-primary scroll-mt-24\",\"children\":[\"What a subscription adds\"]}],[\"$\",\"p\",\"8\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"For farmers who use OneSoil as a daily decision-making tool, tracking how each field develops, planning operations days ahead and comparing fields across the season, the paid tier opens up the features that make this possible:\"]}],\"$L41\",\"$L42\",\"$L43\",\"$L44\",\"$L45\",\"$L46\",\"$L47\",\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\",\"$L55\",\"$L56\",\"$L57\",\"$L58\"]}]}]}]}]\n41:[\"$\",\"ul\",\"9\",{\"className\":\"mx-auto max-w-[864px] mb-4 list-disc\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Season-long history. NDVI, moisture and satellite imagery: see how each field evolves week by week, identify problem areas early, compare zones across the year.\"]}],[\"$\",\"li\",\"1\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"4-hour hyperlocal precipitation forecast. Plan operations with precise short-range forecasting tied to your field, not the nearest weather station.\"]}],[\"$\",\"li\",\"2\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Spraying windows recommendations. Know when conditions are right for treatment.\"]}],[\"$\",\"li\",\"3\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Field boundaries download. Export your field boundaries for use in other systems.\"]}]]}]\n42:[\"$\",\"p\",\"10\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"Coming soon for subscribers:\"]}]\n43:[\"$\",\"ul\",\"11\",{\"className\":\"mx-auto max-w-[864px] mb-4 list-disc\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"VRA suitability: an assessment of which of your fields are suitable for variable-rate application\"]}],[\"$\",\"li\",\"1\",{\"className\":\"ms-[1.7rem] mb-2 text-lg font-light leading-[1.4] text-foreground-primary\",\"children\":[\"Alerts and recommendations based on your current field conditions and historical context\"]}]]}]\n44:[\"$\",\"h2\",\"12\",{\"id\":\"how-subscriptions-work\",\"className\":\"mx-auto max-w-[864px] mb-4 text-[2.25rem] font-normal tracking-[-0.09rem] text-foreground-primary scroll-mt-24\",\"children\":[\"How subscriptions work\"]}]\n45:[\"$\",\"p\",\"13\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"Subscriptions are purchased directly through the App Store or Google Play, in your local currency.\"]}]\n46:[\"$\",\"p\",\"14\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"Pricing adapts to your region and the size of your operation, with additional savings on quarterly plans. You can review the options in the app once you update.\"]}]\n47:[\"$\",\"p\",\"15\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"If you work with a team, the subscription covers your entire workspace: every field, every season and everyone you have invited to work with you. One subscription per workspace, not per person.\"]}]\n48:[\"$\",\"h2\",\"16\",{\"id\":\"for-students-and-educators\",\"className\":\"mx-auto max-w-[864px] mb-4 text-[2.25rem] font-normal tracking-[-0.09rem] text-foreground-primary scroll-mt-24\",\"children\":[\"For students and educators\"]}]\n49:[\"$\",\"p\",\"17\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"If you are using OneSoil for academic or non-commercial purposes, write to us at \",[\"$\",\"a\",\"1\",{\"href\":\"mailto:care@onesoil.ai\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"care@onesoil.ai\"]}],\" and we will keep your access free.\"]}]\n4a:[\"$\",\"h2\",\"18\",{\"id\":\"for-onesoil-pro-customers\",\"className\":\"mx-auto max-w-[864px] mb-4 text-[2.25rem] font-normal tracking-[-0.09rem] text-foreground-primary scroll-mt-24\",\"children\":[\"For OneSoil Pro customers\"]}]\n4b:[\"$\",\"p\",\"19\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"If you have a Pro subscription, the new mobile features are already included. There is nothing you need to do.\"]}]\n4c:[\"$\",\"h2\",\"20\",{\"id\":\"questions-and-answers\",\"className\":\"mx-auto max-w-[864px] mb-4 text-[2.25rem] font-normal tracking-[-0.09rem] text-foreground-primary scroll-mt-24\",\"children\":[\"Questions and answers\"]}]\n4d:[\"$\",\"p\",\"21\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Will I lose my fields and notes if I don’t subscribe?\"}]]}]\n4e:[\"$\",\"p\",\"22\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"No. All your fields, seasons and notes stay in your account exactly as they are. You will continue to access them through the free version, along with the last cloud-free image per field, virtual weather stations and the hyperlocal precipitation map for the next hour.\"]}]\n4f:[\"$\",\"p\",\"23\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Can I try a subscription before committing?\"}]]}]\n50:[\"$\",\"p\",\"24\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"Some plans include a trial period. You will see the details directly in the App Store or Google Play before subscribing, and you can cancel anytime, so there is no long-term commitment.\"]}]\n51:[\"$\",\"p\",\"25\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Can I cancel my subscription later?\"}]]}]\n52:[\"$\",\"p\",\"26\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"Yes, anytime. Subscriptions are managed through your App Store or Google Play account, just like any other app. If you cancel, you keep access to subscription features until the end of your current billing period, then return to the free version automatically.\"]}]\n53:[\"$\",\"p\",\"27\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"How does pricing work for farms with multiple users?\"}]]}]\n54:[\"$\",\"p\",\"28\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"The subscription is tied to your workspace, not to individual users. One subscription covers all fields, all seasons and everyone invited to your workspace. The price depends on the total area of your active fields and your region, and you will see your exact price in the App Store or Google Play.\"]}]\n55:[\"$\",\"p\",\"29\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"What if I have OneSoil Pro?\"}]]}]\n56:[\"$\",\"p\",\"30\",{\"className\":\"mx-auto max-w-[864px] mb-4 text-lg font-light leading-[1.4] text-foreground-primary last:mb-0\",\"children\":[\"If you are a OneSoil Pro customer, all the new mobile subscription features are already included in your existing plan. When you update the app, everything continues to work as before.\"]}]\n57:[\"$\",\"section\",\"31\",{\"aria-labelledby\":\"related-articles-heading\",\"className\":\"relative left-1/2 w-screen -translate-x-1/2 bg-background-secondary\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1024px] px-6 py-8 lg:px-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-5 flex items-center gap-2\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"related-articles-heading\",\"className\":\"text-[2.25rem] font-normal leading-none tracking-[-0.09rem] text-foreground-primary\",\"children\":\"More Articles\"}],[\"$\",\"svg\",null,{\"width\":28,\"height\":28,\"viewBox\":\"0 0 28 28\",\"className\":\"shrink-0 fill-current text-foreground-primary\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"g\",null,{\"transform\":\"translate(0, 0)\",\"children\":[\"$\",\"path\",null,{\"d\":\"M14 1.75C20.7655 1.75 26.25 7.23451 26.25 14C26.25 20.7655 20.7655 26.25 14 26.25C7.23451 26.25 1.75 20.7655 1.75 14C1.75 7.23451 7.23451 1.75 14 1.75ZM11.666 8.45801C11.1833 8.45844 10.7913 8.85025 10.791 9.33301C10.7911 9.81612 11.1839 10.2079 11.667 10.208H16.5547L9.88086 16.8809C9.53941 17.2224 9.53974 17.7764 9.88086 18.1182C10.2226 18.4599 10.7774 18.4599 11.1191