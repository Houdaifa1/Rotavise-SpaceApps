dary-predictions-geoparquet-pmtiles\",\"className\":\"permalink-link\",\"aria-label\":\"Permalink\",\"children\":[\"$\",\"svg\",null,{\"width\":\"15\",\"height\":\"15\",\"viewBox\":\"0 0 15 15\",\"fill\":\"none\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"ref\":\"$undefined\",\"children\":[\"$\",\"path\",null,{\"d\":\"$94\",\"fill\":\"currentColor\",\"fillRule\":\"evenodd\",\"clipRule\":\"evenodd\"}]}]}]],\"data-accent-color\":\"$undefined\",\"id\":\"field-boundary-predictions-geoparquet-pmtiles\",\"style\":\"$undefined\",\"ref\":null,\"className\":\"rt-Heading rt-r-size-6 rt-r-mb-2 heading-with-permalink\"}]\n"])</script><script>self.__next_f.push([1,"6f:[\"$\",\"p\",\"p-4\",{\"children\":[\"The PRUE model runs over the Sentinel-2 feature composites to produce per-pixel field probabilities;\\nvectors are derived by thresholding and polygonizing into \",[\"$\",\"strong\",\"strong-0\",{\"children\":[[\"$\",\"a\",\"a-0\",{\"children\":\"fiboa\",\"data-accent-color\":\"\",\"href\":\"https://fiboa.org\",\"style\":\"$undefined\",\"ref\":null,\"className\":\"rt-Text rt-reset rt-Link rt-underline-always\"}],\"/\",[\"$\",\"a\",\"a-1\",{\"children\":\"vecorel\",\"data-accent-color\":\"\",\"href\":\"https://vecorel.org\",\"style\":\"$undefined\",\"ref\":null,\"className\":\"rt-Text rt-reset rt-Link rt-underline-always\"}],\" GeoParquet v1.1.0\"]}],\", then\\npartitioned \",[\"$\",\"strong\",\"strong-1\",{\"children\":\"one file per country\"}],\" (195 countries / 574 files, ~210 GB; the nine largest countries —\\ne.g. the US, India, China, Brazil — are split by admin subdivision) and enriched with a per-polygon\\n\",[\"$\",\"strong\",\"strong-2\",{\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"inline-code\",\"children\":\"confidence\"}]}],\" column (0–100). Each polygon also carries \",[\"$\",\"code\",\"code-0\",{\"className\":\"inline-code\",\"children\":\"metrics:area\"}],\", \",[\"$\",\"code\",\"code-1\",{\"className\":\"inline-code\",\"children\":\"metrics:perimeter\"}],\", and a\\n\",[\"$\",\"code\",\"code-2\",{\"className\":\"inline-code\",\"children\":\"determination:datetime\"}],\" (2024 or 2025). Query a country partition directly with DuckDB — only the\\nneeded bytes are fetched:\"],\"data-accent-color\":\"$undefined\",\"style\":\"$undefined\",\"ref\":null,\"className\":\"rt-Text rt-r-mb-3\"}]\n"])</script><script>self.__next_f.push([1,"70:[\"$\",\"pre\",\"pre-0\",{\"children\":\"$L95\"}]\n71:[\"$\",\"p\",\"p-5\",{\"children\":\"For web maps, the collection also exposes global PMTiles (a 2024 and a 2025 layer) and per-country\\nPMTiles, with MapLibre styles for plain green boundaries and for shading each field by its confidence.\",\"data-accent-color\":\"$undefined\",\"style\":\"$undefined\",\"ref\":null,\"className\":\"rt-Text rt-r-mb-3\"}]\n96:T806,"])</script><script>self.__next_f.push([1,"M8.51194 3.00541C9.18829 2.54594 10.0435 2.53694 10.6788 2.95419C10.8231 3.04893 10.9771 3.1993 11.389 3.61119C11.8009 4.02307 11.9513 4.17714 12.046 4.32141C12.4633 4.95675 12.4543 5.81192 11.9948 6.48827C11.8899 6.64264 11.7276 6.80811 11.3006 7.23511L10.6819 7.85383C10.4867 8.04909 10.4867 8.36567 10.6819 8.56093C10.8772 8.7562 11.1938 8.7562 11.389 8.56093L12.0077 7.94221L12.0507 7.89929C12.4203 7.52976 12.6568 7.2933 12.822 7.0502C13.4972 6.05623 13.5321 4.76252 12.8819 3.77248C12.7233 3.53102 12.4922 3.30001 12.1408 2.94871L12.0961 2.90408L12.0515 2.85942C11.7002 2.508 11.4692 2.27689 11.2277 2.11832C10.2377 1.46813 8.94398 1.50299 7.95001 2.17822C7.70691 2.34336 7.47044 2.57991 7.1009 2.94955L7.058 2.99247L6.43928 3.61119C6.24401 3.80645 6.24401 4.12303 6.43928 4.31829C6.63454 4.51355 6.95112 4.51355 7.14638 4.31829L7.7651 3.69957C8.1921 3.27257 8.35757 3.11027 8.51194 3.00541ZM4.31796 7.14672C4.51322 6.95146 4.51322 6.63487 4.31796 6.43961C4.12269 6.24435 3.80611 6.24435 3.61085 6.43961L2.99213 7.05833L2.94922 7.10124C2.57957 7.47077 2.34303 7.70724 2.17788 7.95035C1.50265 8.94432 1.4678 10.238 2.11799 11.2281C2.27656 11